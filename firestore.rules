rules_version = '2';
// قواعد الأمان: كل تلميذ يقرأ ويكتب بياناته فقط، والباحثة (وثيقة في admins/{uid}) تقرأ بيانات الجميع.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    match /admins/{uid} {
      allow read: if isMe(uid);
      allow write: if false;            // تُضاف الباحثة يدويًا من لوحة Firebase
    }
    match /students/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create, delete: if isAdmin();
      // التلميذ يحدّث فقط وقت آخر نشاط ونسبة إنجازه؛ لا يغيّر اسمه أو مجموعته أو أسلوبه المعرفي
      allow update: if isAdmin() || (isMe(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'pct', 'modsDone']));

      match /modules/{mid} {
        allow read, write: if isMe(uid) || isAdmin();
      }
      match /events/{eid} {
        allow read: if isMe(uid) || isAdmin();
        allow create: if isMe(uid) && request.resource.data.t is number;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }
  }
}
